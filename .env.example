# Copy to .env.local for `npm run dev`, or set these on your host.

# Google OAuth client ("Sign in with Google").
# Authorized redirect URI: <origin>/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Signs session cookies, CLI tokens and per-canvas file keys. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CANVAS_SECRET=change-me

# Comma-separated emails that own every canvas and choose who may create canvases.
CANVAS_ADMINS=you@example.com

# Where canvases are stored (a mounted volume in production). Defaults to ./data.
# CANVAS_DATA_DIR=/data

# Port for the server (default 4870).
# PORT=4870
